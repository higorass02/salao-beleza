{
  "name": "salao-agendamento",
  "private": true,
  "type": "module",
  "scripts": {
    "clear:laravel": "php artisan optimize:clear && php artisan view:clear && php artisan route:clear && php artisan config:clear && php artisan cache:clear",
    "clear:front": "rm -rf node_modules/.vite public/build && rm -rf storage/framework/views/*",
    "dev": "vite",
    "dev:clean": "yarn clear:laravel && yarn clear:front && vite",
    "build": "vite build"
  },
  "devDependencies": {
    "@fullcalendar/core": "^6.0.0",
    "@fullcalendar/daygrid": "^6.0.0",
    "@fullcalendar/interaction": "^6.0.0",
    "@fullcalendar/timegrid": "^6.0.0",
    "@fullcalendar/vue3": "^6.0.0",
    "@inertiajs/vue3": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.7.0",
    "laravel-vite-plugin": "^1.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0",
    "vite": "^5.0.0"
  }
}
