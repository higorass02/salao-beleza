APP_NAME="Salão de Beleza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=salao
DB_USERNAME=salao
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=480

CACHE_STORE=file

QUEUE_CONNECTION=sync

# -------------------------------------------------------
# E-MAIL
# Local (Docker): MAIL_MAILER=smtp, MAIL_HOST=mailhog
# Produção: troque os valores abaixo pelo seu provedor
#   Ex: Mailtrap, SendGrid, Mailgun, SMTP próprio
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@salaodebeleza.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_URL=http://localhost:5173
